{
  "JOIN": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "meteringPointId",
      "start",
      "energyDirection",
      "participationFactor"
    ],
    "properties": {
      "permissionAdministratorId": {
        "type": "string",
        "title": "Grid operator",
        "description": "Must match the authorized server binding"
      },
      "meteringPointId": {
        "type": "string",
        "title": "Metering point",
        "pattern": "^[A-Za-z0-9]{1,33}$"
      },
      "start": {
        "type": "string",
        "title": "Effective date",
        "format": "date"
      },
      "energyDirection": {
        "type": "string",
        "title": "Energy direction",
        "enum": [
          "CONSUMPTION",
          "GENERATION"
        ]
      },
      "participationFactor": {
        "type": "integer",
        "title": "Participation factor (%)",
        "minimum": 1,
        "maximum": 100
      },
      "allocationFactor": {
        "type": "number",
        "title": "Static allocation share (%)",
        "minimum": 0,
        "maximum": 100,
        "multipleOf": 0.0001
      },
      "distributionModel": {
        "type": "string",
        "title": "Distribution model",
        "enum": [
          "D",
          "S"
        ]
      },
      "meteringInterval": {
        "type": "string",
        "title": "Metering interval",
        "enum": [
          "QH",
          "H",
          "D",
          "V"
        ]
      },
      "transmissionCycle": {
        "type": "string",
        "title": "Transmission cycle",
        "enum": [
          "D",
          "M",
          "V"
        ]
      },
      "purpose": {
        "type": "string",
        "title": "Purpose",
        "minLength": 1,
        "maxLength": 100
      },
      "additionalData": {
        "type": "array",
        "title": "Additional EDA parameters",
        "maxItems": 1000,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "value"
          ],
          "properties": {
            "name": {
              "type": "string",
              "title": "Parameter name",
              "minLength": 1,
              "maxLength": 40
            },
            "value": {
              "type": "string",
              "title": "Parameter value",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      }
    }
  },
